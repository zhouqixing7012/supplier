  "customScript": "//供应商查询详情页展示\n// var ipPort = \"{center-test}\";\n var ipPort = \"{quote-test}\";\n//var ipPort = \"https://supplier-quote-service-test.sohu-inc.com\";\n\nfunction custAppInitAfter(){\n\n\t// 隐藏子表格的新增和删除按钮\n\topspagev.orderLinesDtoListButtonConfig.delete=false;\n\topspagev.orderLinesDtoListButtonConfig.add=false;\n    opspagev.orderLinesDtoListButtonConfig.edit=false;\n\n\tvar supplierName = top.OPSThirdPartyTokenInfo.supplierName;\n\tvar result = OPSExecInterface( ipPort + \"/order/orderInfo/\" + opspagev.formData.orderNumber, {}, \"GET\");\n\n\tif (result.Code != \"Fail\" && result.Content != null && result.Content !=\"\"){    \n        var content = JSON.parse(result.Content)[0]\n\n\t\tconsole.log(content)\n\t\topspagev.formData.id = content.id;\n\t\topspagev.formData.buyer = content.buyer;\n\t\topspagev.formData.buyerName = content.buyerName;\n\t\topspagev.formData.contactPerson = content.contactPerson;\n\t\topspagev.formData.contactPhone = content.contactPhone;\n\t\topspagev.formData.orderNumber = content.orderNumber;\n\t\topspagev.formData.purCompanyName = content.purCompanyName;\n\t\topspagev.formData.purType = content.purType;\n\t\topspagev.formData.purTypeName = content.purTypeName;\n\t\topspagev.formData.status = content.status;\n\t\topspagev.formData.statusDetail = content.statusDetail;\n\t\topspagev.formData.total = content.total;\n\t\topspagev.formData.unifiedPurtype = content.unifiedPurtype;\n\t\topspagev.formData.vendorName = content.vendorName;\n\t\topspagev.formData.contactsPersonName = content.contactsPersonName;\n\t\topspagev.formData.agreementNumber = content.agreementNumber;\n\t\topspagev.formData.agreementName = content.agreementName;\n\t\topspagev.formData.telphone = content.telphone;\n\t\topspagev.formData.deptName = content.deptName;\n\n\t\tvar supplierLicenseExtendDtoList = content.orderLinesDtoList;\n\t\t\n\t\t// 赋值字列表\n\t\tfor (let i = 0; i < supplierLicenseExtendDtoList.length; i++) {\n\t\t\t\n\t\t\topspagev.formData.orderLinesDtoList.push({\n\t\t\t\t\"id\": supplierLicenseExtendDtoList[i].id,\n\t\t\t\t\"materialCode\": supplierLicenseExtendDtoList[i].materialCode,\n\t\t\t\t\"materialName\": supplierLicenseExtendDtoList[i].materialName,\n\t\t\t\t\"materialTypeName\": supplierLicenseExtendDtoList[i].materialTypeName,\n\t\t\t\t\"notaxPrice\": supplierLicenseExtendDtoList[i].notaxPrice,\n\t\t\t\t\"notaxTotalPrice\": supplierLicenseExtendDtoList[i].notaxTotalPrice,\n\t\t\t\t\"quantity\": supplierLicenseExtendDtoList[i].quantity,\n\t\t\t\t\"taxPrice\": supplierLicenseExtendDtoList[i].taxPrice,\n\t\t\t\t\"taxRate\": supplierLicenseExtendDtoList[i].taxRate,\n\t\t\t\t\"taxTotalPrice\": supplierLicenseExtendDtoList[i].taxTotalPrice,\n\t\t\t\t\"totalTax\": supplierLicenseExtendDtoList[i].totalTax\n\t\t\t})\n\n\t\t}\n\n\n    }\n\t\n}",
