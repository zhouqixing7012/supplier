  "customScript": "//供应商查询详情页展示\n// var ipPort = \"{center-test}\";\nvar ipPort = \"{quote-test}\";\n// var ipPort = \"https://supplier-quote-service-test.sohu-inc.com\";\n\nfunction custAppInitAfter(){\n\n\t// 隐藏子表格的新增和删除按钮\n\topspagev.inquiryLinesDtoListButtonConfig.delete=false;\n\topspagev.inquiryLinesDtoListButtonConfig.add=false;\n\n\tvar supplierName = top.OPSThirdPartyTokenInfo.supplierName;\n\tvar result = OPSExecInterface( ipPort + \"/inquiry/inquiryInfo/\"+\"{ThirdPartyToken}\"+\"/\"+opspagev.formData.inquiryNumber, {}, \"GET\");\n\n\tif (result.Code != \"Fail\"){    \n        var content = JSON.parse(result.Content)[0]\n\n\t\tconsole.log(content)\n\t\tvar purCompany = content.inquiryUnit;//获取采购单位 \n\t\tvar rfqNo = content.inquiryNumber;//询价单号\n\t\tvar rfpTitle = content.inquiryTitle;//询价标题\n\t\tvar endTime\t=content.inquiryEndTime;//结束时间\n\t\t\n\t\t//拼接字符串\n\t\tvar data = \"<p >\"+supplierName+\" ，您好<p/>\"+\"<p style='text-indent:2em;'>\"+purCompany+\" 发起的\"+rfpTitle+\"(询价单号：\"+rfqNo+\")已开始报价，详情如下:<p/><p style='text-indent:2em;'> 电子产品询价<p/><p style='color:red;text-indent:2em;' >报价截止时间:\"+endTime+\"，超时自动取消报价资格，请您及时报价！<p/>\";\n\n\t\t// 赋值\t\n\t\topspagev.field102Remark=data;\n\n\t\topspagev.formData.id = content.id;\n\t\topspagev.formData.inquiryStatus = content.inquiryStatus;\n\t\topspagev.formData.inquiryUnit = content.inquiryUnit;\n\t\topspagev.formData.inquiryUserName = content.inquiryUserName;\n\t\topspagev.formData.inquiryWay = content.inquiryWay;\n\t\topspagev.formData.purTypeName = content.purTypeName;\n\t\topspagev.formData.remainingTime = content.remainingTime;\n\t\topspagev.formData.remark = content.remark;\n\t\topspagev.formData.startDate = content.startDate;\n\t\topspagev.formData.endDate = content.endDate;\n\t\topspagev.formData.inquiryEndTime = content.inquiryEndTime;\n\t\topspagev.formData.vendor = content.vendor;\n\t\tvar headerFiles = content.headerFiles;\n\t\tconsole.log(headerFiles);\n\n\t\tif (headerFiles.length > 0){\n\t\t\tvar attachs = [];\n\t\t\tfor (let x = 0; x < headerFiles.length; x++) {\n\t\t\t\tvar attach = {};\n\t\t\t\tattach['name'] = headerFiles[x].name;\n\t\t\t\tattach['fileUniqueId'] = headerFiles[x].fileUniqueId;\n\t\t\t\tattachs.push(attach);\n\t\t\t}\n\t\t\tconsole.log(\"attachs\");\n\t\t\tconsole.log(attachs);\n\t\t\topspagev.formData.headerFiles=attachs;\n\t\t\topspagev.headerFilesUploadFileList();\n\t\t\t// opspagev.setFieldReadOnly(\"headerFiles\", true);\n\t\t\tsetTimeout(()=>{opspagev.setFieldReadOnly(\"headerFiles\", true)},20);\n\t\t}\n\t\t\n\t\t\n\n\t\tvar supplierLicenseExtendDtoList = content.inquiryLinesDtoList\n\t\t\n\t\t// 赋值字列表\n\t\tfor (let i = 0; i < supplierLicenseExtendDtoList.length; i++) {\n\t\t\tvar attachments = [];\n\t\t\tvar lineFiles = supplierLicenseExtendDtoList[i].lineFiles;\n\t\t\t\n\t\t\tfor (let j = 0; j < lineFiles.length; j++) {\n\t\t\t\tvar attachment = {};\n\t\t\t\tattachment['name'] = lineFiles[j].name;\n\t\t\t\tattachment['fileUniqueId'] = lineFiles[j].fileUniqueId;\n\t\t\t\tattachments.push(attachment);\n\t\t\t}\n\t\t\t\n\t\t\t\n\t\t\topspagev.formData.inquiryLinesDtoList.push({\n\t\t\t\t\"id\": supplierLicenseExtendDtoList[i].id,\n\t\t\t\t\"config\": supplierLicenseExtendDtoList[i].config,\n\t\t\t\t\"materialName\": supplierLicenseExtendDtoList[i].materialName,\n\t\t\t\t\"materialTypeName\": supplierLicenseExtendDtoList[i].materialTypeName,\n\t\t\t\t\"quantity\": supplierLicenseExtendDtoList[i].quantity,\n\t\t\t\t\"taxPrice\": supplierLicenseExtendDtoList[i].taxPrice,\n\t\t\t\t\"taxRate\": supplierLicenseExtendDtoList[i].taxRate,\n\t\t\t\t\"unit\": supplierLicenseExtendDtoList[i].unit,\n\t\t\t\t\"attachment\": attachments\n\t\t\t})\n\n\t\t}\n\n\n\n    }\n\t\n}\n\n//触发页面函数\nfunction BizDataChangeCallBack(fieldCode, fieldValue) {\n\n    if (fieldCode == \"taxRateAll\") {\n\t\tvar inquiryLinesDtoList = opspagev.formData.inquiryLinesDtoList;\n\t\tfor (let i = 0; i < inquiryLinesDtoList.length; i++) {\n\t\t\tinquiryLinesDtoList[i].taxRate = fieldValue;\n\n\t\t}\n\n\t}\n}\n\n\n// 提交方法\nfunction custAppResult(formData) {\n\n\tvar id = opspagev.formData.id;\n\tvar inquiryStatus = opspagev.formData.inquiryStatus;\n\tvar inquiryUnit = opspagev.formData.inquiryUnit;\n\tvar inquiryUserName = opspagev.formData.inquiryUserName;\n\tvar inquiryWay = opspagev.formData.inquiryWay;\n\tvar purTypeName = opspagev.formData.purTypeName;\n\tvar remainingTime = opspagev.formData.remainingTime;\n\tvar remark = opspagev.formData.remark;\n\tvar startDate = opspagev.formData.startDate;\n\tvar endDate = opspagev.formData.endDate;\n\tvar inquiryEndTime = opspagev.formData.inquiryEndTime;\n\tvar vendor = opspagev.formData.vendor;\n\n\tvar inquiryLinesDtoLists = [];\n\tfor (var i = 0; i < opspagev.formData.inquiryLinesDtoList.length; i++) {\n\t\tinquiryLinesDtoLists.push({\n\t\t\t\"id\": opspagev.formData.inquiryLinesDtoList[i].id,\n\t\t\t\"config\": opspagev.formData.inquiryLinesDtoList[i].config,\n\t\t\t\"materialName\": opspagev.formData.inquiryLinesDtoList[i].materialName,\n\t\t\t\"materialTypeName\": opspagev.formData.inquiryLinesDtoList[i].materialTypeName,\n\t\t\t\"quantity\": opspagev.formData.inquiryLinesDtoList[i].quantity,\n\t\t\t\"remark\": opspagev.formData.inquiryLinesDtoList[i].remark,\n\t\t\t\"taxPrice\": opspagev.formData.inquiryLinesDtoList[i].taxPrice,\n\t\t\t\"taxRate\": opspagev.formData.inquiryLinesDtoList[i].taxRate,\n\t\t\t\"unit\": opspagev.formData.inquiryLinesDtoList[i].unit,\n\t\t\t\"lineFiles\": opspagev.formData.inquiryLinesDtoList[i].attachment\n\t\t});\n\t}\n\n\tvar inquiryHeadDto = { \"userCode\": \"{UserCode}\", \"userName\": \"{UserName}\", \"deptCode\": \"{DeptCode}\", \"inquiryLinesDtoList\": inquiryLinesDtoLists, \n\t\"id\": id, \"inquiryStatus\": inquiryStatus, \"inquiryUnit\": inquiryUnit, \"inquiryUserName\": inquiryUserName, \"inquiryWay\": inquiryWay, \"purTypeName\": purTypeName, \"remainingTime\": remainingTime, \"remark\": remark, \"startDate\": startDate, \n\t\"endDate\": endDate, \"inquiryEndTime\": inquiryEndTime, \"vendor\": vendor, \"supplierToken\": \"{ThirdPartyToken}\" }\n\n\tconsole.log(\"inquiryHeadDto\");\n\tconsole.log(inquiryHeadDto);\n\treturn inquiryHeadDto;\n}",
