  "customScript": "//审批-修改银行信息脚本\n\nfunction custAppInitAfter() {\n    var ipPort = \"{approval-test}\";\n\n    var approvalNo = null;\n    var approvalType = false;\n    if (opspagev.processInfo != null) {\n        approvalNo = opspagev.processInfo.FormID;\n    } else {\n        approvalNo = opspagev.formData.approvalNo\n        approvalType = true;\n    }\n\n    console.log(\"approvalNo :\" + approvalNo);\n    var result = OPSExecInterface(ipPort + \"/approval/approvalTaskDetail\", { \"approvalNo\": approvalNo }, \"GET\");\n    var data = JSON.parse(result.Content)\n    var hisSupplierBasicInfoDto = data[0].hisSupplierBasicInfoDto;\n    var hisSupplierBankDtoList = data[0].hisSupplierBankDtoList;\n\n    opspagev.formData.supplierName = hisSupplierBasicInfoDto.supplierName;\n    opspagev.formData.supplierType = hisSupplierBasicInfoDto.supplierType;\n\n    for (let i = 0; i < hisSupplierBankDtoList.length; i++) {\n        var accountLicensePicture =[]\n        if(hisSupplierBankDtoList[i].accountLicensePicture != null && hisSupplierBankDtoList[i].accountLicensePicture !=\"\"){\n            accountLicensePicture =[{\"name\":hisSupplierBankDtoList[i].accountLicensePicture+\".png\",\"fileUniqueId\":hisSupplierBankDtoList[i].accountLicensePicture}];\n        }\n\n        opspagev.formData.bankTap.push({\n            \"accountType\": hisSupplierBankDtoList[i].accountType+\"\",\n            \"bank\": { \"dataList\": [{ \"bankName\": hisSupplierBankDtoList[i].bank, \"countryCode\": hisSupplierBankDtoList[i].currencyCode, \"countryName\": hisSupplierBankDtoList[i].country }] },\n            \"branchBank\": hisSupplierBankDtoList[i].branchBank,\n            \"country\": hisSupplierBankDtoList[i].country,\n            \"province\": hisSupplierBankDtoList[i].province,\n            \"city\": hisSupplierBankDtoList[i].city,\n            \"accountName\": hisSupplierBankDtoList[i].accountName,\n            \"accountNumber\": hisSupplierBankDtoList[i].accountNumber,\n            \"currency\": hisSupplierBankDtoList[i].currencyCode+\"\",\n            \"accountLicensePicture\": accountLicensePicture,\n            \"remark\": hisSupplierBankDtoList[i].remark\n        })\n\n    }\n    if (opspagev.formData.supplierType != \"0\") {\n        //当不为企业供应商的时候，隐藏账户类型\n        opspagev.setSubTableColumnVisible(\"bankTap\", \"accountType\", false)\n    }\n\n    opspagev.hideField(\"approvalRecord\")\n    opspagev.hideField(\"approvalProgress\")\n    if (approvalType) {\n        var resultProgress = OPSExecInterface(ipPort + \"/approval/approvalProgress\", { \"supplierCode\": hisSupplierBasicInfoDto.supplierCode }, \"GET\");\n        var dataProgress = JSON.parse(resultProgress.Content)\n        console.log(\"dataProgress : \" + JSON.stringify(dataProgress))\n        if (dataProgress[0] != null && dataProgress[0] != '') {\n            opspagev.formData.approvalNo = dataProgress[0].approvalNo;\n\n            opspagev.formData.approvalTypeName = dataProgress[0].approvalTypeName;\n            var wflProcessFlowLogDtoList = dataProgress[0].wflProcessFlowLogDtoList;\n            if (wflProcessFlowLogDtoList != null && wflProcessFlowLogDtoList != '') {\n                for (var i = 0; i < wflProcessFlowLogDtoList.length; i++) {\n                    opspagev.formData.approvalProgress.push({\n                        \"approveUser\": wflProcessFlowLogDtoList[i].approveUser,\n                        \"approveAgentOrg\": wflProcessFlowLogDtoList[i].approveAgentOrg,\n                        \"nodeName\": wflProcessFlowLogDtoList[i].nodeName,\n                        \"approveTime\": wflProcessFlowLogDtoList[i].approveTime,\n\n                        \"approveIdea\": wflProcessFlowLogDtoList[i].approveIdea,\n                        \"ApproveTypeCode\": wflProcessFlowLogDtoList[i].approveTypeCode\n\n                    })\n\n                }\n            }\n        }\n        opspagev.showField(\"approvalRecord\")\n        opspagev.showField(\"approvalProgress\")\n    }\n    opspagev.isEdit=false\n    if(!approvalType){\n        if(window.parent.OPS_COMMON_SESSIONID){\n            opspagev.successUrl=\"{OPSBasePC}/#/TableList?ReportCode=P202302010ZRFS9&SystemId={SystemId}&PackageCode=SupplierSystem&PublishVersion=0&familySessionId=\"+window.parent.OPS_COMMON_SESSIONID;\n        }else{\n            opspagev.successUrl=\"{OPSBasePC}/#/TableList?ReportCode=P202302010ZRFS9&SystemId={SystemId}&PackageCode=SupplierSystem&PublishVersion=0\";\n        }\n    }\n}\n\n//银行信息隐藏账户类型\nfunction bankTap_AppInitAfter() {\n    opspagev.removeSubTableValidate(\"bankTap\", \"accountType\");\n}\n\nfunction custAppInitBefore(){\n    opspagev.isEdit=true\n}",
