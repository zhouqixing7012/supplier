  "customScript": "\n//供应商查询修改银行信息\nfunction custAppInitAfter() {\n    debugger\n    opspagev.setFieldVisible(\"bankProvinceCity\", false);\n    opspagev.setFieldVisible(\"province\", true);\n    opspagev.setFieldVisible(\"city\", true);\n\n    if (top.OPSThirdPartyTokenInfo != null && top.OPSThirdPartyTokenInfo != \"\") {\n        // 外部第三方进入\n        opspagev.setTipConfig(\"bank\", {\n            \"content\": \"若未查询到目标开户银行，请联系邀请人进行处理\",\n            \"title\": \"\"\n        });\n        opspagev.setTipConfig(\"branchBank\", {\n            \"content\": \"若未查询到目标银行分行，请联系邀请人进行处理\",\n            \"title\": \"\"\n        });\n    } else {\n        if (window.OPSClientName == \"PC\") {\n            opspagev.setTipConfig(\"bank\", {\n                \"content\": \"若未查询到目标开户银行，请点击<a href=\\\"{ebs_add_bank_url}\\\"  style=\\\"color: #409aff;text-decoration:none;\\\" target=\\\"_blank\\\">新增银行</a>进行提交\",\n                \"title\": \"\"\n            });\n            opspagev.setTipConfig(\"branchBank\", {\n                \"content\": \"若未查询到目标银行分行，请点击<a href=\\\"{ebs_add_bank_url}\\\"  style=\\\"color: #409aff;text-decoration:none;\\\" target=\\\"_blank\\\">新增银行</a>进行提交\",\n                \"title\": \"\"\n            });\n        } else {\n            opspagev.setTipConfig(\"bank\", {\n                \"content\": \"若未查询到目标开户银行，请点击<a href=\\\"{ebs_add_bank_hxe_url}\\\"  style=\\\"color: #409aff;text-decoration:none;\\\" target=\\\"_blank\\\">新增银行</a>进行提交\",\n                \"title\": \"\"\n            });\n            opspagev.setTipConfig(\"branchBank\", {\n                \"content\": \"若未查询到目标银行分行，请点击<a href=\\\"{ebs_add_bank_hxe_url}\\\"  style=\\\"color: #409aff;text-decoration:none;\\\" target=\\\"_blank\\\">新增银行</a>进行提交\",\n                \"title\": \"\"\n            });\n        }\n    }\n\n    // if (opspagev.formData.countryCode != null && opspagev.formData.countryCode != \"\" && opspagev.formData.countryCode == \"CN\"){\n    //     opspagev.setFieldVisible(\"bankProvinceCity\", true);\n    //     opspagev.setFieldVisible(\"province\", false);\n    //     opspagev.setFieldVisible(\"city\", false);\n    // }else{\n    //     opspagev.setFieldVisible(\"bankProvinceCity\", false);\n    //     opspagev.setFieldVisible(\"province\", true);\n    //     opspagev.setFieldVisible(\"city\", true);\n    // }\n}\n\n//触发页面函数\n// function BizDataChangeCallBack(fieldCode, fieldValue, index, formData) {\n//     if (fieldCode == \"bank\") {\n//         setTimeout(() => {\n//             if (formData.countryCode != null && formData.countryCode != \"\" && formData.countryCode == \"CN\") {\n//                 opspagev.setFieldVisible(\"bankProvinceCity\", true);\n//                 opspagev.setFieldVisible(\"province\", false);\n//                 opspagev.setFieldVisible(\"city\", false);\n//             }else{\n//                 opspagev.setFieldVisible(\"bankProvinceCity\", false);\n//                 opspagev.setFieldVisible(\"province\", true);\n//                 opspagev.setFieldVisible(\"city\", true);\n//             }\n//         }, 11);\n//     }\n//     if (fieldCode == \"bankProvinceCity\") {\n//         setTimeout(() => {\n//             formData.province = formData.bankProvinceCity.ProvinceName;\n//             formData.city = formData.bankProvinceCity.CityName;\n//         }, 11);\n//     }\n//\n// }\n\n//ocr识别后调用接口赋值\nfunction BizDataChangeCallBackAfter(fieldCode, fieldValue, index, formData) {\n    if (fieldCode == \"accountLicensePicture\") {\n        if (formData.accountNumber != \"\" && formData.accountNumber != null) {\n            formData.accountNumber = formData.accountNumber.split(\" \").join(\"\");\n        }\n    }\n}\n\n//提交前处理数据\nfunction custAppResult(resultObj){\n    debugger\n    console.log(\"resultObjGO:\"+JSON.stringify(resultObj));\n    var resultObjNew = JSON.parse(JSON.stringify(resultObj));\n    resultObjNew.userCode = \"{UserCode}\";\n    resultObjNew.deptCode = \"{DeptCode}\";\n    resultObjNew.method = \"2\";\n    resultObjNew.userName = \"{UserName}\";\n    resultObjNew.accountLicensePicture = resultObj.accountLicensePicture[0].fileUniqueId;\n    resultObjNew.bank = resultObj.bank.dataList[0].bankName;\n    resultObjNew.branchBank = resultObj.branchBank.dataList[0].branchBank;\n    console.log(\"resultObjTO:\"+JSON.stringify(resultObjNew));\n    return resultObjNew;\n}\n\nfunction custAppValidate() {\n    debugger\n    let bankName1 = opspagev.formData.branchBank.dataList[0].bankName;\n    let bankName2 = opspagev.formData.bank.dataList[0].bankName;\n\n    if (bankName1 !== bankName2) {\n        return \"开户银行与银行分行不匹配，请重新选择\";\n    }\n    return \"\";\n}\n\nfunction custAppMsg(){\n    var msg= {\n        \"confirmMsg\":\"是否确认提交？\"\n    };\n    if(opspagev.formData.supplierName != opspagev.formData.accountName){\n        console.log(\"lalala\");\n        msg= {\n            \"confirmMsg\":\"账户名称和供应商名称不同，是否确认提交？\"\n        };\n    }\n    return msg;\n}",
