  "customScript": "//快速注册供应商\n\nfunction custAppInitAfter(){\n    opspagev.hideField(\"setUpWriter\");\n}\n\nfunction custAppResult(formData) {\n\n    var supplierName = opspagev.formData.supplierName;\n    if (supplierName != null && supplierName != \"\") {\n        supplierName = supplierName.trim();\n    }\n    var supplierType = opspagev.formData.supplierType;\n    var unifiedSocialCertificateCode = opspagev.formData.unifiedSocialCertificateCode;\n    if (unifiedSocialCertificateCode != null && unifiedSocialCertificateCode != \"\") {\n        unifiedSocialCertificateCode = unifiedSocialCertificateCode.trim();\n    }\n    var resultUnifiedSocialCertificateCode = OPSExecInterface(ipPort + \"/supplier/socialCreditCode\", { \"socialCreditCode\": unifiedSocialCertificateCode }, \"GET\");\n    console.log(\"统一社会信用代码:\" + JSON.stringify(resultUnifiedSocialCertificateCode))\n    if (resultUnifiedSocialCertificateCode.Message == \"社会统一信用代码已存在！\") {\n        return \"统一社会信用代码已存在！\";\n    }\n\n    var departmentID = opspagev.formData.department.dataList[0].DeptID;\n    var departmentName = opspagev.formData.department.dataList[0].FullDeptName\n    var payCompany = opspagev.formData.payCompany.dataList[0].id;\n    var payCompanyName = opspagev.formData.payCompany.dataList[0].title;\n    var remark = opspagev.formData.remark;\n\n    var authTap = opspagev.formData.authTap;\n    var supplierBusinessVoList = []\n    var sourceFlge = opspagev.formData.setUpWriter;\n    var source = -1;\n    if(sourceFlge){\n        source =0\n    }\n\n    for (let i = 0; i < authTap.length; i++) {\n        supplierBusinessVoList.push({\n            \"ownedBusiness\": authTap[i].ownedBusiness,\n            \"businessCategory\": authTap[i].businessCategory,\n            \"deptNo\": departmentID,\n            \"deptName\": departmentName,\n            \"payCompany\": payCompany,\n            \"payCompanyName\": payCompanyName\n        })\n    }\n    //\"registerWay\"待定\n    var supplierBasicInfoVo = { \"supplierName\": supplierName, \"supplierType\": supplierType, \"supplierLicenseCode\": unifiedSocialCertificateCode, \"registerWay\": 3,\"source\":source }\n    var supplierBasicBusinessOuVo = { \"userCode\": \"{UserCode}\", \"userName\": \"{UserName}\", \"deptCode\": \"{DeptCode}\", \"supplierBasicInfoVo\": supplierBasicInfoVo, \"supplierBusinessVoList\": supplierBusinessVoList }\n    console.log(\"supplierParamsVo 接口入参:\" + JSON.stringify(supplierBasicBusinessOuVo));\n    return supplierBasicBusinessOuVo;\n}\nvar ipPort = \"{center-test}\";\nfunction BizDataChangeCallBack(fieldCode, fieldValue, index, formData) {\n    console.log(\"fieldCode:\" + fieldCode, \",fieldValue:\" + fieldValue, \",index:\" + index, formData, 'BizDataChangeCallBack')\n    if (fieldCode == \"authTap_ownedBusiness\") {\n        formData.businessCategory = \"\";\n    }\n\n    if (fieldCode == \"authTap_businessCategory\") {\n        var authTap = opspagev.formData.authTap;\n        console.log(\"authTap:\" + JSON.stringify(authTap))\n        if (authTap.length > 1) {\n            for (var i = 0; i < authTap.length; i++) {\n                if (authTap[i].businessCategory == formData.businessCategory && index-1 != i && (authTap[i].businessCategory != \"\" && authTap[i].businessCategory != null) && ( formData.businessCategory != \"\" &&  formData.businessCategory != null)) {\n                    formData.businessCategory = \"\";\n                    OPSMessage(\"error\", \"权限类型不能重复\");\n                }\n\n            }\n        }\n\n    }\n\n\n    if (fieldCode == \"unifiedSocialCertificateCode\") {\n        var unifiedSocialCertificateCode = opspagev.formData.unifiedSocialCertificateCode;\n        var resultBlackSupplier = OPSExecInterface(ipPort + \"/supplier/supplierBlackVerification\", { \"unifiedSocialCertificateCode\": unifiedSocialCertificateCode }, \"GET\");\n        if ( resultBlackSupplier.Message == \"供应商已拉黑！\") {\n            OPSMessage(\"error\", resultBlackSupplier.Message);\n        }else{\n            var resultUnifiedSocialCertificateCode = OPSExecInterface(ipPort + \"/supplier/socialCreditCode\", { \"socialCreditCode\": unifiedSocialCertificateCode }, \"GET\");\n            console.log(\"统一社会信用代码:\" + JSON.stringify(resultUnifiedSocialCertificateCode))\n            if (resultUnifiedSocialCertificateCode.Message == \"社会统一信用代码或证件号已存在！\") {\n                OPSMessage(\"error\", resultUnifiedSocialCertificateCode.Message);\n            }\n        }\n\n\n    }\n    if(fieldCode == \"supplierType\"){\n        if(fieldValue == 1){\n            var userIpPort = \"{supplier-user}\"\n            var UserGroupDto = OPSExecInterface(userIpPort + \"/api/user/sohuUserPermissions/\"+\"{UserCode}\" , { \"UserCode\":\"{UserCode}\" }, \"GET\");\n            var data = JSON.parse(UserGroupDto.Content)\n            if (data != null && data != '' ){\n                var code = data[0].code\n                if(code == 'admin_supplier' || code == 'expLaPeople'){\n                    opspagev.showField(\"setUpWriter\");\n                }\n            }\n\n        }else{\n            opspagev.hideField(\"setUpWriter\");\n        }\n\n    }\n\n}\n\n// 提交前校验\nfunction custAppValidate() {\n    debugger\n    // 判断权益重叠是否已点击校验\n    if (opspagev.formData.supplierType != \"1\") {\n        var result = OPSExecInterface(ipPort + \"/supplier/supplierName\", {\"supplierName\": opspagev.formData.supplierName}, \"GET\");\n        if (result.Code == \"Fail\") {\n            return result.Message;\n        }\n        return \"\";\n    }\n}",
