  "customScript": "var ipPort = \"{travel-test}\";\nvar gatewayIpPort = \"{gateway-travel}\";\nvar gatewayConsumerIdentity = \"{gateway-travel-ConsumerIdentity}\"\n// var ipPort=\"http://10.2.129.233:40084\";\n\nfunction custAppInitAfter(){\n    debugger\n    // 获取token中的供应商编码信息\n    var supplierCode = top.OPSThirdPartyTokenInfo.supplierCode;\n    console.log(supplierCode)\n\n    var result = OPSExecInterface(ipPort+\"/travel/travelBillResource\", { \"supplierToken\": \"{ThirdPartyToken}\" }, \"GET\");\n    console.log(\"提交返回内容\")\n    console.log(result)\n\n    if (result.Code != \"Fail\"){\n        opspagev.showField(\"field101\");\n        opspagev.showField(\"field113\");\n        opspagev.showField(\"field104\");\n        opspagev.showField(\"productSelection\");\n        opspagev.showField(\"field106\");\n        opspagev.showField(\"field112\");\n        var content = JSON.parse(result.Content)[0]\n        console.log(content)\n        var comIdSet = content.comIdSet[0]\n        opspagev.formData.productSelection = comIdSet+\"\";\n\n        var resourceSet = content.resourceSet\n        for (let resource in resourceSet) {\n            console.log(resourceSet[resource])\n            opspagev.showField(\"bill\" + resourceSet[resource]);\n        }\n    }else{\n        opspagev.hideField(\"field101\");\n        opspagev.hideField(\"field113\");\n        opspagev.hideField(\"field104\");\n        opspagev.hideField(\"productSelection\");\n        opspagev.hideField(\"field106\");\n        opspagev.hideField(\"field112\");\n        OPSMessage(\"warning\", result.Message);\n    }\n\n\n\n}\n\n/**\n * 将 jQuery Ajax 的传输层失败信息转换为页面现有失败分支可展示的文本。\n *\n * 超时优先返回明确的 180 秒提示；其他失败优先采用后端 JSON 响应中的\n * `Message`，以保留供应商服务给出的业务说明，最后才使用通用提示。\n *\n * @param {jqXHR} jqXHR - jQuery 失败回调提供的 HTTP 响应对象。\n * @param {string} textStatus - jQuery 失败状态，例如 `timeout` 或 `error`。\n * @param {string} errorThrown - 浏览器或 jQuery 提供的原始错误文本。\n * @returns {string} 可直接传给 `OPSMessage` 的中文失败提示。\n */\nfunction buildTravelBillAjaxFailureMessage(jqXHR, textStatus, errorThrown) {\n    if (textStatus === \"timeout\") {\n        return \"差旅账单处理超时，请稍后确认处理结果。\";\n    }\n\n    if (jqXHR && jqXHR.responseJSON && jqXHR.responseJSON.Message) {\n        return jqXHR.responseJSON.Message;\n    }\n\n    if (errorThrown) {\n        return errorThrown;\n    }\n\n    return \"差旅账单请求失败，请稍后重试。\";\n}\n\nfunction extractedPop(params) {\n    debugger\n    if (params.resourceType == '1') {\n        opspagev.formData.bill1.pop();\n        opspagev.bill1UploadFileList();\n    }\n    if (params.resourceType == '2') {\n        opspagev.formData.bill2.pop();\n        opspagev.bill2UploadFileList();\n    }\n    if (params.resourceType == '3') {\n        opspagev.formData.bill3.pop();\n        opspagev.bill3UploadFileList();\n    }\n    if (params.resourceType == '4') {\n        opspagev.formData.bill4.pop();\n        opspagev.bill4UploadFileList();\n    }\n}\n\nfunction extractedShift(params) {\n    debugger\n    if (params.resourceType == '1' && opspagev.formData.bill1.length > 1) {\n        opspagev.formData.bill1.shift();\n        opspagev.bill1UploadFileList();\n    }\n    if (params.resourceType == '2' && opspagev.formData.bill2.length > 1) {\n        opspagev.formData.bill2.shift();\n        opspagev.bill2UploadFileList();\n    }\n    if (params.resourceType == '3' && opspagev.formData.bill3.length > 1) {\n        opspagev.formData.bill3.shift();\n        opspagev.bill3UploadFileList();\n    }\n    if (params.resourceType == '4' && opspagev.formData.bill4.length > 1) {\n        opspagev.formData.bill4.shift();\n        opspagev.bill4UploadFileList();\n    }\n}\n\n/**\n * 同步提交账单附件信息到供应商差旅服务，并将传输层异常转换为业务失败结果。\n *\n * `async: false` 会阻塞页面线程，直到服务返回、网络失败或达到 180 秒超时；\n * 调用方可继续复用原有的 `Code` 和 `Message` 判断逻辑。\n *\n * @param {object} params - 与原 `OPSExecInterface` 完全相同的账单提交参数。\n * @returns {object} 服务端业务响应，或含 `Code: \"Fail\"` 的标准失败结果。\n */\nfunction executeTravelBillRequest(params) {\n    debugger\n    OPSLoading({\"text\":\"数据处理中，请稍等\"})\n\n    $.ajax({\n        url: gatewayIpPort + \"/travel/travelBill\",\n        type: \"POST\",\n        async: true,\n        timeout: 180000,\n        contentType: \"application/json; charset=UTF-8\",\n        dataType: \"json\",\n        data: JSON.stringify(params),\n        headers: {\n            \"Consumer-Identity\": gatewayConsumerIdentity\n        },\n        success:\n            /**\n             * 保存供应商接口返回的原始业务结果，供字段回调沿用既有失败判断。\n             *\n             * @param {object} response - 服务端返回的包含 `Code` 和 `Message` 的业务对象。\n             * @returns {void} 通过闭包变量保存响应，不额外改变页面状态。\n             */\n            function handleTravelBillAjaxSuccess(response) {\n                OPSLoading(false);\n                if (!response) {\n                    extractedPop(params);\n                    OPSMessage(\"warning\", \"差旅账单接口未返回处理结果，请稍后重试。\");\n                }else if (response.code != '2000') {\n                    extractedPop(params);\n                    OPSMessage(\"warning\", response.msg);\n                } else {\n                    extractedShift(params);\n                }\n            },\n        error:\n            /**\n             * 将 HTTP、网络、超时及 JSON 解析错误收敛为标准的业务失败结果。\n             *\n             * @param {jqXHR} jqXHR - jQuery 失败回调提供的 HTTP 响应对象。\n             * @param {string} textStatus - jQuery 失败状态。\n             * @param {string} errorThrown - 浏览器或 jQuery 提供的错误文本。\n             * @returns {void} 通过闭包变量保存可展示的失败结果。\n             */\n            function handleTravelBillAjaxError(jqXHR, textStatus, errorThrown) {\n                OPSLoading(false);\n                extractedPop(params);\n                OPSMessage(\"warning\", buildTravelBillAjaxFailureMessage(jqXHR, textStatus, errorThrown));\n            }\n    });\n}\n\nfunction BizDataChangeCallBackAfter(fieldCode,fieldValue){\n    debugger\n    if (\"bill1\" == fieldCode || \"bill2\" == fieldCode || \"bill3\" == fieldCode || \"bill4\" == fieldCode){\n        // 获取token中的供应商编码信息\n        var supplierCode = top.OPSThirdPartyTokenInfo.supplierCode;\n        console.log(\"====================================================\")\n        console.log(supplierCode)\n\n        var result = OPSExecInterface(ipPort+\"/travel/travelBillResource\", {\"supplierToken\": \"{ThirdPartyToken}\"}, \"GET\");\n        console.log(result)\n        if (result.Code != \"Fail\"){\n            var content = JSON.parse(result.Content)[0]\n            var comIdSet = content.comIdSet[0]\n            var resourceType = 0;\n            if (\"bill1\" == fieldCode){\n                resourceType = 1;\n            }\n            if (\"bill2\" == fieldCode){\n                resourceType = 2;\n            }\n            if (\"bill3\" == fieldCode){\n                resourceType = 3;\n            }\n            if (\"bill4\" == fieldCode){\n                resourceType = 4;\n            }\n            executeTravelBillRequest({\n                comId: comIdSet,\n                resourceType: resourceType,\n                supplierToken: \"{ThirdPartyToken}\",\n                name: fieldValue[fieldValue.length - 1].name,\n                fileUniqueId: fieldValue[fieldValue.length - 1].fileUniqueId\n            });\n        }else{\n            OPSMessage(\"warning\", result.Message);\n        }\n    }\n\n}",
