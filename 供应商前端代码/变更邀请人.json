  "customScript": "\nfunction custAppInitAfter(){\n    debugger\n    opspagev.formData.oldInviterName = \"{UserName}\";\n    var supplierIds = opspagev.formData.supplierIds;\n    var param={\n        \"supplierIds\":supplierIds\n    };\n\tconsole.log(\"sendC:\"+JSON.stringify(param)); \n    OPSExecInterface(\"{center-test}/supplier/supplierBasicInfoList\",param,'GET',true,(result)=>{\n        console.log(\"result:\"+JSON.stringify(result));\n        if(result.Code==\"Success\"){\n            var jsonContent = JSON.parse(result.Content);\n            console.log(\"jsonContent:\"+JSON.stringify(jsonContent));\n            debugger\n            opspagev.formData.supplierBasicInfoDtoList = jsonContent;\n            opspagev.supplierBasicInfoDtoListButtonConfig.edit=false\n            opspagev.supplierBasicInfoDtoListButtonConfig.delete=false\n        }else{\n             OPSMessage(\"error\",result.Message,3);\n        }\n    });\n}\n\nfunction BizDataChangeCallBackAfter(fieldCode, fieldValue) {\n    if (fieldCode == \"inviter\") {\n        if(opspagev.formData.inviterCode == \"{UserCode}\"){\n            OPSMessage(\"error\", \"变更邀请人不能与原邀请人一致！\");\n            opspagev.formData.inviter.dataList=[];\n        }\n    }\n}\n\n\n//数据提交前处理\nfunction custAppResult(resultObj){\n    debugger\n    console.log(\"resultObj:\"+JSON.stringify(resultObj));\n    var result = {};\n    result.approvalType = 3;\n    result.userCode = \"{UserCode}\";\n    result.userName = \"{UserName}\";\n    result.deptCode = \"{DeptCode}\";\n\n    var supplierBasicInfoDtoList = resultObj.supplierBasicInfoDtoList;\n    supplierBasicInfoDtoList.forEach(function(item) {\n        // 为每个对象增加一个新的键值对\n        item.inviter = opspagev.formData.inviterName;\n        item.inviterCode = opspagev.formData.inviterCode;\n        item.oldInviter = \"{UserName}\";\n        item.oldInviterCode = \"{UserCode}\";\n    });\n\n    result.hisSupplierBasicInfoDtoList = supplierBasicInfoDtoList;\n    console.log(\"result:\"+JSON.stringify(result));\n    return result;\n} ",
  "customCSS": ".customHeader h3:before {\n    content: \"\";\n    width: 4px;\n    height: 14px;\n    border-radius: 4px;\n    background: #409aff;\n    display: inline-block;\n    margin: 0px 9px 0px 22px;\n    margin-bottom: -3px;\n}",
