  "customScript": "var ipPort = \"{center-test}\";\nvar userIpPort = \"{supplier-user}\"\n\n//供应商邀请注册判断与入参数据整合\nfunction BizDataChangeCallBack(fieldCode, fieldValue) {\n\n    if (opspagev.formData.supplierCode == null || opspagev.formData.supplierCode == \"\") {\n\n\n        if (fieldCode == \"supplierName\") {\n\n            // var ipPort=\"https://supplier-center-service-test.sohu-inc.com\";\n            var supplierName = opspagev.formData.supplierName\n            supplierName = supplierName.trim();\n            var result = OPSExecInterface(ipPort + \"/supplier/supplierName\", { \"supplierName\": supplierName }, \"GET\");\n            console.log(\"提交返回内容\")\n            console.table(result)\n            if (result.Code == \"Fail\") {\n                OPSMessage(\"error\", result.Message);\n                opspagev.formData.supplierName = \"\";\n            }\n        }\n\t\tif (fieldCode == \"abroadSupplierName\") {\n\n            // var ipPort=\"https://supplier-center-service-test.sohu-inc.com\";\n            var supplierName = opspagev.formData.abroadSupplierName\n            supplierName = supplierName.trim();\n            var result = OPSExecInterface(ipPort + \"/supplier/supplierName\", { \"supplierName\": supplierName }, \"GET\");\n            console.log(\"提交返回内容\")\n            console.table(result)\n            if (result.Code == \"Fail\") {\n                OPSMessage(\"error\", result.Message);\n                opspagev.formData.abroadSupplierName = \"\";\n            }\n        }\n    }\n    if (fieldCode == \"supplierType\") {\n        debugger\n        if (fieldValue == \"1\") {\n            opspagev.hideField(\"supplierName\");\n            opspagev.showField(\"name\");\n\t\t\topspagev.hideField(\"abroadSupplierName\");\n            opspagev.hideField(\"abroadInviteRegisterContactPhone\");\n            var UserGroupDto = OPSExecInterface(userIpPort + \"/api/user/sohuUserPermissions/\"+\"{UserCode}\" , { \"UserCode\":\"{UserCode}\" }, \"GET\");\n            var data = JSON.parse(UserGroupDto.Content)\n            if (data != null && data != '' ){\n               var code = data[0].code\n                if(code == 'admin_supplier' || code == 'expLaPeople'){\n                    opspagev.showField(\"setUpWriter\");\n                }\n            }\n        } else {\n            opspagev.hideField(\"name\");\n            opspagev.showField(\"supplierName\");\n            opspagev.showField(\"inviteRegisterContactPhone\");\n\t\t\topspagev.hideField(\"abroadSupplierName\");\n            opspagev.hideField(\"abroadInviteRegisterContactPhone\");\n            opspagev.hideField(\"setUpWriter\");\n            \n\t\t\tif(fieldValue == \"3\"){\n\t\t\t\topspagev.hideField(\"supplierName\");\n\t\t\t\topspagev.showField(\"abroadSupplierName\");\n                opspagev.hideField(\"inviteRegisterContactPhone\");\n\t\t\t\topspagev.showField(\"abroadInviteRegisterContactPhone\");\n\t\t\t}\n        }\n\n    }\n    \n}\n\nfunction custAppResult(formData) {\n    var supplierCode = opspagev.formData.supplierCode;\n    var supplierIds = opspagev.formData.supplierId + \"\"\n    if (supplierIds != \"\" && supplierIds != null && opspagev.formData.registerWay == \"1\") {\n        var result = OPSExecInterface(ipPort + \"/supplier/supplierInfo/\" + supplierIds, {}, \"DELETE\");\n        console.log(JSON.stringify(result));\n        supplierCode = null;\n    }\n\n    var supplierName = opspagev.formData.supplierName;\n\n    if (opspagev.formData.supplierType == \"1\") {\n        supplierName = opspagev.formData.name;\n    }\n\tif (opspagev.formData.supplierType == \"3\") {\n        supplierName = opspagev.formData.abroadSupplierName;\n    }\n    supplierName = supplierName.trim();\n    var inviteRegisterContact = opspagev.formData.inviteRegisterContact\n    if (inviteRegisterContact != null && inviteRegisterContact != \"\") {\n        inviteRegisterContact = inviteRegisterContact.trim();\n    }\n\n    var inviteRegisterContactEmail = opspagev.formData.inviteRegisterContactEmail\n    if (inviteRegisterContactEmail != null && inviteRegisterContactEmail != \"\") {\n        inviteRegisterContactEmail = inviteRegisterContactEmail.trim();\n    }\n    var inviteRegisterContactPhone = opspagev.formData.inviteRegisterContactPhone\n    if (opspagev.formData.supplierType == \"3\") {\n        inviteRegisterContactPhone = opspagev.formData.abroadInviteRegisterContactPhone;\n    }\n    if (inviteRegisterContactPhone != null && inviteRegisterContactPhone != \"\") {\n        inviteRegisterContactPhone = inviteRegisterContactPhone.trim();\n    }\n    var sourceFlge = opspagev.formData.setUpWriter;\n    var source = -1;\n    if(sourceFlge){\n        source =0\n    }\n\n    var inviteSupplierParamsVo = { \"userCode\": \"{UserCode}\", \"userName\": \"{UserName}\", \"deptCode\": \"{DeptCode}\", \"supplierType\": opspagev.formData.supplierType, \"supplierName\": supplierName, \"inviteRegisterContact\": inviteRegisterContact, \"inviteRegisterContactEmail\": inviteRegisterContactEmail, \"inviteRegisterContactPhone\": inviteRegisterContactPhone, \"supplierCode\": supplierCode,\"source\":source };\n    console.log(JSON.stringify(inviteSupplierParamsVo))\n    return inviteSupplierParamsVo;\n}\n\nfunction custAppInitAfter() {\n    opspagev.hideField(\"setUpWriter\");\n    opspagev.hideField(\"name\")\n    opspagev.showField(\"supplierName\");\n    opspagev.showField(\"inviteRegisterContactPhone\");\n\topspagev.hideField(\"abroadSupplierName\");\n    opspagev.hideField(\"abroadInviteRegisterContactPhone\");\n    if (opspagev.formData.supplierType == \"1\") {\n        opspagev.showField(\"name\")\n        opspagev.hideField(\"supplierName\");\n        var UserGroupDto = OPSExecInterface(userIpPort + \"/api/user/sohuUserPermissions/\"+\"{UserCode}\" , { \"UserCode\":\"{UserCode}\" }, \"GET\");\n            var data = JSON.parse(UserGroupDto.Content)\n            if (data != null && data != '' ){\n               var code = data[0].code\n                if(code == 'admin_supplier' || code == 'expLaPeople'){\n                    opspagev.showField(\"setUpWriter\");\n                    if(opspagev.formData.source == 0){\n                        opspagev.formData.setUpWriter = true;\n                    }\n                }\n            }\n    }else if(opspagev.formData.supplierType == \"3\"){\n        opspagev.hideField(\"supplierName\");\n\t\topspagev.showField(\"abroadSupplierName\");\n        opspagev.hideField(\"inviteRegisterContactPhone\");\n\t\topspagev.showField(\"abroadInviteRegisterContactPhone\");\n    }\n    \n    BizDataChangeCallBack(\"supplierType\",opspagev.formData.supplierType)\n}",
