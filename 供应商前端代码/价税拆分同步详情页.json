  "customScript": "//供应商查询详情页展示\n// var ipPort = \"{center-test}\";\nvar ipPort = \"{quote-test}\";\n//var ipPort = \"https://supplier-quote-service-test.sohu-inc.com\";\n\nfunction custAppInitAfter(){\n\n\t// 隐藏子表格的新增和删除按钮\n\topspagev.orderLinesDtoListButtonConfig.delete=false;\n\topspagev.orderLinesDtoListButtonConfig.add=false;\n\n\tvar supplierName = top.OPSThirdPartyTokenInfo.supplierName;\n\tvar result = OPSExecInterface( ipPort + \"/order/orderInfo/\" + opspagev.formData.orderNumber, {}, \"GET\");\n\n\tif (result.Code != \"Fail\" && result.Content != null && result.Content !=\"\"){    \n        var content = JSON.parse(result.Content)[0]\n\n\t\tconsole.log(content)\n\t\topspagev.formData.id = content.id;\n\t\topspagev.formData.buyer = content.buyer;\n\t\topspagev.formData.buyerName = content.buyerName;\n\t\topspagev.formData.contactPerson = content.contactPerson;\n\t\topspagev.formData.contactPhone = content.contactPhone;\n\t\topspagev.formData.orderNumber = content.orderNumber;\n\t\topspagev.formData.purCompanyName = content.purCompanyName;\n\t\topspagev.formData.purType = content.purType;\n\t\topspagev.formData.purTypeName = content.purTypeName;\n\t\topspagev.formData.status = content.status;\n\t\topspagev.formData.statusDetail = content.statusDetail;\n\t\topspagev.formData.total = content.total;\n\t\topspagev.formData.unifiedPurtype = content.unifiedPurtype;\n\t\topspagev.formData.vendorName = content.vendorName;\n\t\topspagev.formData.contactsPersonName = content.contactsPersonName;\n\t\topspagev.formData.agreementNumber = content.agreementNumber;\n\t\topspagev.formData.agreementName = content.agreementName;\n\t\topspagev.formData.telphone = content.telphone;\n\t\topspagev.formData.deptName = content.deptName;\n\t\t\n\t\t\n\t\n\n\t\tvar supplierLicenseExtendDtoList = content.orderLinesDtoList;\n\t\t\n\t\t// 赋值字列表\n\t\tfor (let i = 0; i < supplierLicenseExtendDtoList.length; i++) {\n\t\t\t\n\t\t\topspagev.formData.orderLinesDtoList.push({\n\t\t\t\t\"id\": supplierLicenseExtendDtoList[i].id,\n\t\t\t\t\"materialCode\": supplierLicenseExtendDtoList[i].materialCode,\n\t\t\t\t\"materialName\": supplierLicenseExtendDtoList[i].materialName,\n\t\t\t\t\"materialTypeName\": supplierLicenseExtendDtoList[i].materialTypeName,\n\t\t\t\t\"notaxPrice\": supplierLicenseExtendDtoList[i].notaxPrice,\n\t\t\t\t\"notaxTotalPrice\": supplierLicenseExtendDtoList[i].notaxTotalPrice,\n\t\t\t\t\"quantity\": supplierLicenseExtendDtoList[i].quantity,\n\t\t\t\t\"taxPrice\": supplierLicenseExtendDtoList[i].taxPrice,\n\t\t\t\t\"taxRate\": supplierLicenseExtendDtoList[i].taxRate,\n\t\t\t\t\"taxTotalPrice\": supplierLicenseExtendDtoList[i].taxTotalPrice,\n\t\t\t\t\"totalTax\": supplierLicenseExtendDtoList[i].totalTax\n\t\t\t})\n\n\t\t}\n\n\n    }\n\t\n}\n\n\n// 提交方法\nfunction custAppResult(formData) {\n\n\tvar id = opspagev.formData.id;\n\tvar buyer = opspagev.formData.buyer;\n\tvar buyerName = opspagev.formData.buyerName;\n\tvar contactPerson = opspagev.formData.contactPerson;\n\tvar contactPhone = opspagev.formData.contactPhone;\n\tvar orderNumber = opspagev.formData.orderNumber;\n\tvar purCompanyName = opspagev.formData.purCompanyName;\n\tvar purType = opspagev.formData.purType;\n\tvar purTypeName = opspagev.formData.purTypeName;\n\tvar status = opspagev.formData.status;\n\tvar statusDetail = opspagev.formData.statusDetail;\n\tvar total = opspagev.formData.total;\n\tvar unifiedPurtype = opspagev.formData.unifiedPurtype;\n\tvar vendorName = opspagev.formData.vendorName;\n\tvar contactsPersonName = opspagev.formData.contactsPersonName;\n\tvar agreementNumber = opspagev.formData.agreementNumber;\n\tvar agreementName = opspagev.formData.agreementName;\n\tvar telphone = opspagev.formData.telphone;\n\tvar deptName = opspagev.formData.deptName;\n\n\tvar orderLinesDtoLists = [];\n\tfor (var i = 0; i < opspagev.formData.orderLinesDtoList.length; i++) {\n\t\torderLinesDtoLists.push({\n\t\t\t\"id\": opspagev.formData.orderLinesDtoList[i].id,\n\t\t\t\"materialCode\": opspagev.formData.orderLinesDtoList[i].materialCode,\n\t\t\t\"materialName\": opspagev.formData.orderLinesDtoList[i].materialName,\n\t\t\t\"materialTypeName\": opspagev.formData.orderLinesDtoList[i].materialTypeName,\n\t\t\t\"notaxPrice\": opspagev.formData.orderLinesDtoList[i].notaxPrice == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].notaxPrice,\n\t\t\t\"notaxTotalPrice\": opspagev.formData.orderLinesDtoList[i].notaxTotalPrice == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].notaxTotalPrice,\n\t\t\t\"quantity\": opspagev.formData.orderLinesDtoList[i].quantity == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].quantity,\n\t\t\t\"taxPrice\": opspagev.formData.orderLinesDtoList[i].taxPrice == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].taxPrice,\n\t\t\t\"taxRate\": opspagev.formData.orderLinesDtoList[i].taxRate == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].taxRate,\n\t\t\t\"taxTotalPrice\": opspagev.formData.orderLinesDtoList[i].taxTotalPrice == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].taxTotalPrice,\n\t\t\t\"totalTax\": opspagev.formData.orderLinesDtoList[i].totalTax == \"\" ? \"0\" : opspagev.formData.orderLinesDtoList[i].totalTax\n\t\t});\n\t}\n\n\tvar orderHeadDto = { \"userCode\": \"{UserCode}\", \"userName\": \"{UserName}\", \"deptCode\": \"{DeptCode}\", \"orderLinesDtoList\": orderLinesDtoLists, \n\t\"id\": id, \"buyer\": buyer, \"buyerName\": buyerName, \"contactPerson\": contactPerson, \"contactPhone\": contactPhone,  \"telphone\": telphone,  \"deptName\": deptName, \n\t\"orderNumber\": orderNumber, \"purCompanyName\": purCompanyName, \"purType\": purType, \"purTypeName\": purTypeName,  \"agreementNumber\": agreementNumber, \"agreementName\": agreementName,\n\t\"status\": status, \"statusDetail\": statusDetail, \"total\": total, \"unifiedPurtype\": unifiedPurtype, \"vendorName\": vendorName, \"contactsPersonName\": contactsPersonName }\n\n\tconsole.log(\"orderHeadDto\");\n\tconsole.log(orderHeadDto);\n\treturn orderHeadDto;\n}\n\nfunction BizDataChangeCallBack(fieldCode, fieldValue, index, formData) {\n    // 含税单价 taxPrice\n    // 不含税单价 notaxPrice\n    // 含税金额 taxTotalPrice\n    // 不含税金额 notaxTotalPrice\n    // 税率 taxRate\n    // 税额 totalTax\n\n    debugger\n    // 税率taxRate\n    if (fieldCode === \"orderLinesDtoList_taxRate\") {\n        var taxRate = parseTaxRate(fieldValue);\n        var taxPrice = getFloat(formData.taxPrice);\n\n        // 「不含税单价」为空\n        // 不含税单价=含税单价➗（1+税率）\n        if (taxPrice !== 0) {\n            var calculatedNoTaxPrice = taxPrice / (1 + taxRate);\n\n            // 处理14位字符限制\n            // 策略：计算整数部分长度，剩余给小数部分，总长度不超过14\n            var intPartStr = Math.floor(Math.abs(calculatedNoTaxPrice)).toString();\n            // 如果是负数，符号位也占一位\n            var signLen = calculatedNoTaxPrice < 0 ? 1 : 0;\n            var intPartLen = intPartStr.length + signLen;\n\n            // 1位小数点\n            var maxDecimals = 14 - intPartLen - 1;\n            if (maxDecimals < 0) {\n                maxDecimals = 0;\n            }\n\n            // 先按照最大允许长度截断\n            var str = calculatedNoTaxPrice.toFixed(maxDecimals);\n            // 去除多余 0\n            var compactStr = parseFloat(str).toString();\n            var finalNoTaxPriceStr = compactStr;\n\n            // 如果空间允许（maxDecimals >= 2），且当前不足 2 位小数，则补足 2 位\n            if (maxDecimals >= 2) {\n                var parts = compactStr.split('.');\n                var currentDecimals = parts.length > 1 ? parts[1].length : 0;\n                if (currentDecimals < 2) {\n                    finalNoTaxPriceStr = parseFloat(compactStr).toFixed(2);\n                }\n            }\n\n            // 不含税单价 notaxPrice\n            formData.notaxPrice = finalNoTaxPriceStr;\n\n            // 不含税金额=含税金额️➗（1+税率）\n            formData.notaxTotalPrice = (formData.taxTotalPrice / (1 + taxRate)).toFixed(2);\n\n            // 税额=含税金额-不含税金额\n            formData.totalTax = (formData.taxTotalPrice - (formData.taxTotalPrice / (1 + taxRate))).toFixed(2);\n        }\n    }\n}\n\n// 辅助函数：解析浮点数\nfunction getFloat(val) {\n    if (val === \"\" || val === null || val === undefined) {\n        return 0;\n    }\n    return parseFloat(val);\n}\n\n// 辅助函数：判空\nfunction isEmpty(val) {\n    return val === \"\" || val === null || val === undefined;\n}\n\n// 辅助函数：解析税率\n// 税率输入的值是除了%之外的部分，比如输入13，则后面计算时当做13%来参与计算\nfunction parseTaxRate(val) {\n    if (isEmpty(val)) {\n        return 0;\n    }\n    // 例如输入13，当做13%来处理，转换为0.13\n    return parseFloat(val) / 100;\n}",
